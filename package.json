{
  "name": "bb-plugin-art-day",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.6.157",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Art Day",
    "description": "Discover a daily museum painting, read its story in Russian or English based on your system language, and shape selections with ratings.",
    "branding": {
      "icon": "./art-day.svg",
      "logo": {
        "light": "./starry-night.png",
        "dark": "./starry-night.png"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "description": "A daily museum painting, a short story, and recommendations shaped by your taste.",
  "files": [
    "server.ts",
    "app.tsx",
    "art-day.tsx",
    "art-day.css",
    "art-day.svg",
    "fresh-art.mjs",
    "scheduler.mjs",
    "prompt.mjs",
    "skills",
    "README.md",
    "SECURITY.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "dist",
    "starry-night.png",
    "i18n.mjs",
    "localization.mjs"
  ],
  "scripts": {
    "test": "node --test *.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
